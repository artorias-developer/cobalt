BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010

APP_DOMAIN={{domain}}
APP_PEPPER={{pepper}}
APP_BCRYPT_ROUNDS=12
APP_ENVIRONMENT=prod
APP_DEBUG_MODE=0
APP_DEBUG_PORT=5678

POSTGRES_HOST=prod_cobalt_postgres
POSTGRES_PORT=5432
POSTGRES_USER=cobalt
POSTGRES_PASSWORD={{postgres_password}}
POSTGRES_DB=cobalt_prod
POSTGRES_POOL_SIZE=30
POSTGRES_POOL_RECYCLE=300
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_PRE_PING=1
POSTGRES_ECHO=0
POSTGRES_EXPIRE_ON_COMMIT=0

REDIS_HOST=prod_cobalt_redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD={{redis_password}}

PROMETHEUS_HOST=prod_cobalt_prometheus
PROMETHEUS_PORT=9090

CONTAINERS_SOCKET_PATH=/var/run/docker.sock
CONTAINERS_BASE_URL=http://localhost
CONTAINERS_CLI_PATH=docker

LOGGER_NAME=cobalt.app
LOGGER_FORMAT="%(asctime)s %(levelname)s %(message)s"
LOGGER_DATE_FMT="%Y-%m-%d %H:%M:%S"
LOGGER_MAX_SIZE=10485760
LOGGER_BACKUP_COUNT=1
LOGGER_FILE=cobalt.log
