FROM debian:bookworm-slim

ARG SERVER_ROOT

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        wget \
        ca-certificates \
        lib32gcc-s1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && wget -qO- "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz" | tar zxf - -C /usr/local/bin \
    && mkdir -p /installer_src

COPY scripts/upgrader.sh /installer_src/upgrader.sh

RUN chmod +x /installer_src/upgrader.sh

WORKDIR ${SERVER_ROOT}

CMD ["/installer_src/upgrader.sh"]