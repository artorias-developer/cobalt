FROM debian:bookworm-slim

ARG INSTALLATION_DIR

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR ${INSTALLATION_DIR}

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        wget \
        rsync \
        ca-certificates \
        lib32gcc-s1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && wget -qO- "https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz" | tar zxf - -C /usr/local/bin

COPY data/ ./
COPY scripts/installer.sh scripts/runtime.sh ./

RUN chmod +x installer.sh runtime.sh

CMD ["/bin/bash", "-c", "exec ./installer.sh"]