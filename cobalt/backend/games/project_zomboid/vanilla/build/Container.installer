FROM debian:bookworm-slim AS steamcmd

ADD https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz /tmp/steamcmd_linux.tar.gz

WORKDIR /steamcmd

RUN tar zxf /tmp/steamcmd_linux.tar.gz -C /steamcmd

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        bash \
        wget \
        rsync \
        ca-certificates \
        lib32gcc-s1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=steamcmd /steamcmd/ /usr/local/bin/

ARG INSTALLATION_DIR

WORKDIR ${INSTALLATION_DIR}

COPY data/ ./
COPY --chmod=755 scripts/installer.sh scripts/runtime.sh ./

CMD ["/bin/bash", "-c", "exec ./installer.sh"]