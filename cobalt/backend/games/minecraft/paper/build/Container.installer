FROM alpine:latest

ARG PAPER_LINK
ARG INSTALLATION_DIR

WORKDIR ${INSTALLATION_DIR}

RUN apk add --no-cache \
        bash \
        rsync \
        wget \
        ca-certificates \
    && wget ${PAPER_LINK} -O paper-server.jar \
    && apk del \
        wget \
        ca-certificates

COPY data/ ./
COPY scripts/installer.sh scripts/runtime.sh ./

RUN chmod +x installer.sh runtime.sh

CMD ["/bin/bash", "-c", "exec ./installer.sh"]