FROM debian:bookworm-slim

ARG JAVA_VERSION
ARG FORGE_LINK
ARG INSTALLATION_DIR

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR ${INSTALLATION_DIR}

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        rsync \
        wget \
        ca-certificates \
        gnupg \
    && wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" > /etc/apt/sources.list.d/adoptium.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        temurin-${JAVA_VERSION}-jdk \
    && wget ${FORGE_LINK} -O forge-installer.jar \
    && java -jar forge-installer.jar --installServer \
    && rm -rf forge-installer.jar forge-installer.jar.log \
    && apt-get purge -y --auto-remove \
        temurin-${JAVA_VERSION}-jdk \
        wget \
        gnupg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY data/ ./
COPY scripts/installer.sh scripts/runtime.sh ./

RUN chmod +x installer.sh runtime.sh

CMD ["/bin/bash", "-c", "exec ./installer.sh"]