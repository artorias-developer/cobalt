FROM debian:bookworm-slim AS adoptium

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        gnupg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ADD https://packages.adoptium.net/artifactory/api/gpg/key/public /tmp/adoptium.asc

RUN gpg --dearmor -o /usr/share/keyrings/adoptium.gpg /tmp/adoptium.asc \
    && echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb bookworm main" > /etc/apt/sources.list.d/adoptium.list

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        bash \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=adoptium --chmod=644 /usr/share/keyrings/adoptium.gpg /usr/share/keyrings/adoptium.gpg
COPY --from=adoptium --chmod=644 /etc/apt/sources.list.d/adoptium.list /etc/apt/sources.list.d/adoptium.list

ARG JAVA_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        temurin-${JAVA_VERSION}-jdk \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ARG SERVER_ROOT

WORKDIR ${SERVER_ROOT}

ENTRYPOINT ["/bin/bash", "-c", "exec ./runtime.sh"]