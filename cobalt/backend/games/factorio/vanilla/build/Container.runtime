FROM debian:bookworm-slim

ARG SERVER_ROOT

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR ${SERVER_ROOT}

RUN apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        bash \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENTRYPOINT ["/bin/bash", "-c", "exec ./runtime.sh"]