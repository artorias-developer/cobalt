FROM alpine:latest

ARG FACTORIO_LINK
ARG INSTALLATION_DIR

WORKDIR ${INSTALLATION_DIR}

RUN apk add --no-cache \
        bash \
        rsync \
        wget \
        ca-certificates \
        xz \
    && wget ${FACTORIO_LINK} -O server.tar.xz \
    && tar -xf server.tar.xz --strip-components=1 \
    && rm -f server.tar.xz \
    && mkdir -p saves mods \
    && apk del \
        wget \
        ca-certificates \
        xz

COPY data/ ./
COPY scripts/installer.sh scripts/runtime.sh ./

RUN chmod +x installer.sh runtime.sh

CMD ["/bin/bash", "-c", "exec ./installer.sh"]