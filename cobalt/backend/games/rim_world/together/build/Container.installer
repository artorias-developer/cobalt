FROM alpine:latest

ARG TOGETHER_LINK
ARG INSTALLATION_DIR

WORKDIR ${INSTALLATION_DIR}

RUN apk add --no-cache \
        bash \
        rsync \
        wget \
        ca-certificates \
        unzip \
    && wget ${TOGETHER_LINK} -O server.zip \
    && unzip server.zip \
    && rm -f server.zip \
    && chmod +x GameServer \
    && apk del \
        wget \
        ca-certificates \
        unzip

COPY data/ ./
COPY scripts/installer.sh scripts/runtime.sh ./

RUN chmod +x installer.sh runtime.sh

CMD ["/bin/bash", "-c", "exec ./installer.sh"]