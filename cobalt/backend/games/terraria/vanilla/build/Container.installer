FROM alpine:latest

ARG TERRARIA_LINK
ARG INSTALLATION_DIR

WORKDIR ${INSTALLATION_DIR}

RUN apk add --no-cache \
        bash \
        rsync \
        wget \
        ca-certificates \
        unzip \
    && wget ${TERRARIA_LINK} -O server.zip \
    && unzip server.zip -d /tmp/terraria \
    && cp -r /tmp/terraria/*/Linux/. . \
    && chmod +x TerrariaServer.bin.x86_64 \
    && rm -rf /tmp/terraria server.zip \
    && apk del \
        wget \
        ca-certificates \
        unzip

COPY data/ ./
COPY scripts/installer.sh scripts/runtime.sh ./

RUN chmod +x installer.sh runtime.sh

CMD ["/bin/bash", "-c", "exec ./installer.sh"]