FROM alpine:latest

ARG TMODLOADER_LINK
ARG INSTALLATION_DIR

WORKDIR ${INSTALLATION_DIR}

RUN apk add --no-cache \
        bash \
        rsync \
        wget \
        ca-certificates \
        unzip \
    && wget ${TMODLOADER_LINK} -O server.zip \
    && unzip server.zip \
    && if [ -d "Build" ]; then \
        mv Build/* . \
        && rm -rf Build; \
    fi \
    && chmod +x LaunchUtils/ScriptCaller.sh \
    && rm -rf server.zip serverconfig.txt \
    && mkdir -p data/Mods \
             data/Mods/ModPacks \
             data/ModConfigs \
    && apk del \
        wget \
        ca-certificates \
        unzip

COPY data/ ./
COPY scripts/installer.sh scripts/runtime.sh ./

RUN chmod +x installer.sh runtime.sh

CMD ["/bin/bash", "-c", "exec ./installer.sh"]