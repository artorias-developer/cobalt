FROM alpine:3.24.2 AS downloader

RUN apk add --no-cache \
        unzip

ARG TMODLOADER_LINK

WORKDIR /tmodloader

ADD ${TMODLOADER_LINK} server.zip

RUN unzip server.zip \
    && if [ -d "Build" ]; then \
        mv Build/* . \
        && rm -rf Build; \
    fi \
    && chmod +x LaunchUtils/ScriptCaller.sh \
    && rm -rf server.zip serverconfig.txt \
    && mkdir -p data/Mods \
             data/Mods/ModPacks \
             data/ModConfigs

FROM alpine:3.24.2

RUN apk add --no-cache \
        bash \
        rsync

ARG INSTALLATION_DIR

WORKDIR ${INSTALLATION_DIR}

COPY --from=downloader /tmodloader/ ./
COPY data/ ./
COPY --chmod=755 scripts/installer.sh scripts/runtime.sh ./

CMD ["/bin/bash", "-c", "exec ./installer.sh"]