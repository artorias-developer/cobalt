FROM debian:bookworm-slim

ARG SERVER_ROOT

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR ${SERVER_ROOT}

RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install -y --no-install-recommends --no-install-suggests \
        bash \
        lib32gcc-s1 \
        lib32stdc++6 \
        libsdl2-2.0-0 \
        libsdl2-2.0-0:i386 \
        ca-certificates \
        netcat-openbsd \
    && update-ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /root/.steam/sdk64 \
    && ln -sf ${SERVER_ROOT}/7DaysToDieServer_Data/Plugins/x86_64/steamclient.so /root/.steam/sdk64/steamclient.so

ENV LD_LIBRARY_PATH="/root/.steam/sdk64:${SERVER_ROOT}/7DaysToDieServer_Data/Plugins/x86_64:${SERVER_ROOT}:${LD_LIBRARY_PATH}"

ENTRYPOINT ["/bin/bash", "-c", "exec ./runtime.sh"]